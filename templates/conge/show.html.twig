{% extends 'base.html.twig' %}
{% block title %}Détail de la demande{% endblock %}
{% block body %}
<h1 class="h3 mb-3">Demande de congé</h1>
<dl class="row">
    <dt class="col-sm-3">Type</dt><dd class="col-sm-9">{{ conge.typeConge.nom }}</dd>
    <dt class="col-sm-3">Période</dt><dd class="col-sm-9">{{ conge.dateDebut|date('d/m/Y') }} — {{ conge.dateFin|date('d/m/Y') }}</dd>
    <dt class="col-sm-3">Statut</dt><dd class="col-sm-9">{{ conge.statut }}</dd>
    {% if conge.validateur %}
        <dt class="col-sm-3">Traité par</dt><dd class="col-sm-9">{{ conge.validateur }}</dd>
    {% endif %}
    {% if conge.commentaire %}
        <dt class="col-sm-3">Commentaire</dt><dd class="col-sm-9">{{ conge.commentaire }}</dd>
    {% endif %}
</dl>
<a href="{{ path('conge_index') }}" class="btn btn-secondary">Retour</a>
{% endblock %}
