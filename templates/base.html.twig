<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Gestion des congés{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('conge_index') }}">Gestion des congés</a>
        {% if app.user %}
            <div class="navbar-nav flex-row gap-3">
                <a class="nav-link text-white" href="{{ path('conge_index') }}">Mes congés</a>
                {% if is_granted('ROLE_RESPONSABLE') %}
                    <a class="nav-link text-white" href="{{ path('responsable_index') }}">À traiter</a>
                {% endif %}
                {% if is_granted('ROLE_RH') %}
                    <a class="nav-link text-white" href="{{ path('admin_dashboard') }}">Administration</a>
                {% endif %}
            </div>
            <div class="ms-auto navbar-nav flex-row gap-3">
                <a class="nav-link text-white-50" href="{{ path('profil_changer_mot_de_passe') }}">{{ app.user }}</a>
                <a class="nav-link text-white" href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
        {% endif %}
    </div>
</nav>

<div class="container">
    {% for label, messages in app.flashes(['success', 'error']) %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>
</body>
</html>
