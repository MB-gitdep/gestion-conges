<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Gestion des congés{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# viewport correct pour un rendu mobile propre (zoom, largeur d'écran) #}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('conge_index') }}">Gestion des congés</a>

        {% if app.user %}
            {# Bouton visible uniquement sur petit écran, replie le menu #}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-label="Afficher/masquer le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <div class="navbar-nav flex-column flex-lg-row gap-lg-3">
                    <a class="nav-link text-white" href="{{ path('conge_index') }}">Mes congés</a>
                    {% if is_granted('ROLE_RESPONSABLE') %}
                        <a class="nav-link text-white" href="{{ path('responsable_index') }}">À traiter</a>
                    {% endif %}
                    {% if is_granted('ROLE_RH') %}
                        <a class="nav-link text-white" href="{{ path('admin_dashboard') }}">Administration</a>
                    {% endif %}
                </div>
                <div class="navbar-nav flex-column flex-lg-row gap-lg-3 ms-lg-auto mt-2 mt-lg-0">
                    <a class="nav-link text-white-50" href="{{ path('profil_changer_mot_de_passe') }}">{{ app.user }}</a>
                    <a class="nav-link text-white" href="{{ path('app_logout') }}">Déconnexion</a>
                </div>
            </div>
        {% endif %}
    </div>
</nav>

<div class="container">
    {% for label, messages in app.flashes(['success', 'error']) %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

{# JS Bootstrap : uniquement nécessaire au bouton de repli du menu mobile #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
