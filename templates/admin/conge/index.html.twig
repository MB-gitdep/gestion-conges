{% extends 'base.html.twig' %}
{% block title %}Demandes de congés{% endblock %}
{% block body %}
<div class="row">
    <div class="col-md-3">{% include 'admin/_menu.html.twig' %}</div>
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3">Demandes de congés</h1>
            <div class="btn-group">
                <a href="{{ path('admin_conge_index') }}" class="btn btn-outline-secondary {{ statutFiltre is null ? 'active' }}">Toutes</a>
                <a href="{{ path('admin_conge_index', {statut: 'en_attente'}) }}" class="btn btn-outline-secondary {{ statutFiltre == 'en_attente' ? 'active' }}">En attente</a>
                <a href="{{ path('admin_conge_index', {statut: 'valide'}) }}" class="btn btn-outline-secondary {{ statutFiltre == 'valide' ? 'active' }}">Validées</a>
                <a href="{{ path('admin_conge_index', {statut: 'refuse'}) }}" class="btn btn-outline-secondary {{ statutFiltre == 'refuse' ? 'active' }}">Refusées</a>
            </div>
        </div>
        <div class="table-responsive">
<table class="table">
            <thead><tr><th>Demandeur</th><th>Type</th><th>Période</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            {% for conge in conges %}
                <tr>
                    <td>{{ conge.utilisateur }}</td>
                    <td>{{ conge.typeConge.nom }}</td>
                    <td>{{ conge.dateDebut|date('d/m/Y') }} — {{ conge.dateFin|date('d/m/Y') }}</td>
                    <td>
                        <span class="badge bg-{{ conge.statut == 'valide' ? 'success' : (conge.statut == 'refuse' ? 'danger' : 'warning') }}">
                            {{ conge.statut }}
                        </span>
                    </td>
                    <td>
                        {% if conge.statut == 'en_attente' %}
                            <a href="{{ path('admin_conge_repondre', {id: conge.id}) }}">Traiter</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted">Aucune demande.</td></tr>
            {% endfor %}
            </tbody>
        </table>
</div>
    </div>
</div>
{% endblock %}
