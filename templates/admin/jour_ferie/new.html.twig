{% extends 'base.html.twig' %}
{% block title %}Nouveau jour férié{% endblock %}
{% block body %}
<h1 class="h3 mb-3">Ajouter un jour férié</h1>
{{ form_start(form) }}
    {{ form_row(form.entreprise) }}
    {{ form_row(form.date) }}
    {{ form_row(form.libelle) }}
    <button class="btn btn-primary" type="submit">Ajouter</button>
{{ form_end(form) }}
{% endblock %}
