{% extends 'base.html.twig' %}
{% block title %}Modifier l'utilisateur{% endblock %}
{% block body %}
<h1 class="h3 mb-3">Modifier « {{ utilisateur }} »</h1>
{{ form_start(form) }}
    {{ form_row(form.nom) }}
    {{ form_row(form.prenom) }}
    {{ form_row(form.email) }}
    {{ form_row(form.roles) }}
    {{ form_row(form.dateEntree) }}
    {{ form_row(form.statut) }}
    <button class="btn btn-primary" type="submit">Enregistrer</button>
{{ form_end(form) }}
<a href="{{ path('admin_utilisateur_services', {id: utilisateur.id}) }}" class="btn btn-outline-secondary mt-2">Gérer ses services</a>
{% endblock %}
