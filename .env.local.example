# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# .env.local ne doit JAMAIS être commité (déjà exclu par .gitignore).

APP_ENV=prod
APP_DEBUG=0
# Générez un secret fort et unique : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGEZ_MOI_avec_une_valeur_aleatoire_forte

DATABASE_URL="mysql://app_user:CHANGEZ_MOI@127.0.0.1:3306/gestion_conges?serverVersion=11.4-MariaDB&charset=utf8mb4"

# En développement local : MAILER_DSN=null://null (aucun envoi réel)
MAILER_DSN=smtp://user:motdepasse@smtp.votredomaine.fr:587

# Si l'application est derrière un reverse proxy (Nginx devant Apache, load balancer)
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
